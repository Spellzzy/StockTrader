# Stock Trader AI 配置文件
# 复制此文件为 config.yaml 并填入你的配置:
#   cp config.yaml.example config.yaml
#
# 密钥推荐用环境变量注入，避免写进 config.yaml（优先级高于本文件）:
#   STOCK_AI_AI__LLM__API_KEY            → ai.llm.api_key
#   STOCK_AI_NOTIFICATION__PUSHPLUS__TOKEN → notification.pushplus.token
# 规则：前缀 STOCK_AI_ + 双下划线分隔层级，段名/键名大小写不敏感。

# 数据库配置
database:
  path: "./data/stock_trader.db"

# stock-data CLI 路径
stock_data:
  # Windows 系统已将 stock-data.exe 复制到 System32
  bin_path: "stock-data"

# 默认市场
market:
  default: "A"  # A股/港股(HK)/美股(US)
  # 实时行情缓存秒数：同一批代码在 TTL 内复用上次结果，避免重复启动
  # stock-data 子进程（实测每次 1.2~3 秒）。0 = 关闭缓存，每次都拉新。
  # 也可用环境变量 STOCK_AI_MARKET__QUOTE_CACHE_SECONDS 覆盖。
  quote_cache_seconds: 20

# 涨跌颜色方案
# "red_up" = 红涨绿跌 (A股惯例)
# "green_up" = 绿涨红跌 (美股/国际惯例)
color_scheme: "red_up"

# 数据缓存
cache:
  enabled: true
  dir: "./data/cache"
  expire_minutes: 30  # K线等数据缓存时间

# 可视化
visualization:
  default_backend: "matplotlib"  # matplotlib / plotly
  theme: "dark"  # dark / light
  save_dir: "./data/charts"

# 费率（交易录入与回测共用同一套口径）
fees:
  commission_rate: 0.0003    # 佣金费率 (万三)
  min_commission: 5.0        # 单笔最低佣金 (元)
  stamp_tax_rate: 0.001      # 印花税率 (千一，仅 A股 卖出收取)

# AI 配置
ai:
  # LLM 分析引擎 (Phase 3)
  llm:
    # 支持: openai / deepseek / moonshot / dashscope / zhipu / ollama
    provider: "openai"
    api_key: ""                    # 你的 API Key (ollama 不需要)
    model: "gpt-4o"                # 模型名称
    base_url: ""                   # 自定义 API 地址 (可选，留空则自动匹配 provider)
    # 免费方案: 安装 Ollama 后设置 provider: "ollama", model: "qwen2.5:7b"
  # ML/DL 模型存储
  model:
    save_dir: "./data/models"
    expire_days: 30            # 模型过期天数（过期只告警，不阻止使用）

# 消息推送配置
notification:
  enabled: true              # 全局开关
  on_alert: true             # 预警触发时推送
  on_trade: false            # 交易成交时推送（已实现，由 TradeService.add_trade 触发）

  channels:
    # Server酱 — 免费微信推送 (https://sct.ftqq.com)
    serverchan:
      enabled: false
      send_key: ""           # 登录 sct.ftqq.com 获取

    # PushPlus — 免费微信推送 (https://www.pushplus.plus)
    pushplus:
      enabled: false
      token: ""              # 登录 pushplus.plus 获取

    # 钉钉群机器人
    dingtalk:
      enabled: false
      webhook: ""            # 群设置→智能群助手→添加机器人→自定义
      secret: ""             # 安全设置→加签密钥

    # 飞书群机器人
    feishu:
      enabled: false
      webhook: ""            # 群设置→群机器人→自定义机器人
      secret: ""             # 安全设置密钥 (可选)

    # Telegram Bot
    telegram:
      enabled: false
      bot_token: ""          # @BotFather 创建
      chat_id: ""            # 你的 chat_id

    # 邮件 SMTP
    email:
      enabled: false
      smtp_host: "smtp.qq.com"
      smtp_port: 465
      use_ssl: true
      username: ""           # 发件邮箱
      password: ""           # SMTP 授权码（不是登录密码）
      to: ""                 # 收件邮箱

    # 企业微信群机器人
    wecom:
      enabled: false
      webhook: ""            # 群聊→添加群机器人→Webhook地址

# 预警监控配置
alerts:
  check_interval: 30         # 默认检测间隔 (秒)
  watch_interval: 30         # 看盘模式刷新间隔 (秒)
  cooldown_minutes: 30       # 可重复触发的预警冷却时间（避免每轮重复推送，0=不冷却）

# 本地 Web UI（stock-ai web / 双击 启动.bat）
web:
  host: "127.0.0.1"         # 只绑本机，不要改成 0.0.0.0
  port: 8765
  open_browser: true        # 启动后自动打开浏览器

# 功能开关
features:
  order_enabled: false        # 订单执行层暂不开放；true 才会在 CLI 挂载 stock-ai order

# 券商通道 / 订单编排（默认只出草稿，绝不自动真实下单）
# 注意：整个执行层当前处于「冻结」状态，见 features.order_enabled
broker:
  enabled: false             # kill switch：false 时 --live 一律被拒绝
  name: "manual"             # manual=人工确认 / mock=影子 / paper=模拟盘
  draft_dir: "./data/orders" # 订单草稿输出目录
  # 密钥不要写这里，用环境变量: STOCK_AI_BROKER__ENABLED 等

risk:
  whitelist: []              # 允许下单的代码白名单（空=不限制）
  max_order_amount: 50000    # 单笔上限 (元)
  max_daily_amount: 100000   # 单日累计上限 (元)
  max_positions: 10          # 最大持仓只数
  max_position_ratio: 0.3    # 单票占总资产上限
  timeout_minutes: 30        # 未成交草稿/委托超时
  require_confirmation: true # 真实提交必须人工 --yes 二次确认

# 回测引擎配置
backtest:
  initial_capital: 100000    # 默认初始资金 (元)
  # commission_rate / tax_rate 留空则沿用上面 fees 段的费率
  fill_mode: "next_open"     # 成交方式: next_open=信号次日开盘成交 / close=信号当日收盘成交(含前视偏差)
  slippage: 0.0              # 滑点比例 (0.001 = 0.1%)
  stop_loss: 0.0             # 默认止损比例 (0=不止损, 0.05=5%)
  take_profit: 0.0           # 默认止盈比例 (0=不止盈, 0.1=10%)
  position_size: 1.0         # 单次建仓资金比例 (0~1)
  default_days: 180          # 默认回测天数
  default_strategy: "macd_cross"  # 默认策略

# 选股引擎配置
# 用法: stock-ai sn / stock-ai sn --side sell / stock-ai sn --pool all_a
screener:
  # 股票池: watchlist=自选股 / portfolio=持仓 / all_a=全A股 / file:./codes.txt / 逗号分隔代码
  pool: "watchlist"
  min_kline: 30              # 单只股票最少 K 线根数（不足则跳过）
  kline_count: 90            # 用于计算指标的 K 线根数
  benchmark: "sz399101"      # 行业/大盘基准（sector_strong 条件用）
  max_workers: 4             # 并发线程数（全A扫描建议 4~8）
  all_a_cache_days: 7        # 全A代码缓存有效期（天）
  pool_size_limit: 0         # 池规模上限（0=不限）
  exclude_delisted: true     # 过滤已退市/长期停牌
  exclude_st: false          # 过滤 ST/*ST 股
  max_kline_age_days: 14     # K线最新日期距今超过该天数则跳过

  # ── 买入规则 ──
  buy:
    # 聚合模式: all=全部满足 / any=任一满足 / atleast:N=至少N个满足
    mode: "all"
    rules:
      - name: ma_uptrend            # MA20 向上
        params: { ma: 20, lookback: 5 }
      - name: price_above_ma        # 股价站上 MA20
        params: { ma: 20 }
      - name: volume_expand         # 成交量放大: 当日量 ≥ 5日均量 × 1.5
        params: { ma_window: 5, ratio: 1.5 }
      - name: sector_strong         # 行业板块强势: 5日涨幅强于基准
        params: { window: 5, advantage: 0.0 }

  # ── 卖出规则 ──
  sell:
    mode: "any"   # 任一触发即卖
    rules:
      - name: price_below_ma        # 跌破 MA10
        params: { ma: 10 }
      - name: bearish_volume        # 放量长阴: 跌幅≥3% 且 量比≥1.5
        params: { drop_pct: 3.0, vol_ratio: 1.5, ma_window: 5 }
      - name: loss_pct              # 亏损达到 8%
        params: { threshold: 8.0 }

  # 可用条件（`stock-ai sn --list-conditions` 查看完整说明）：
  #   ma_uptrend / price_above_ma / price_below_ma / volume_expand
  #   sector_strong / ma_bull / macd_golden / macd_dead
  #   rsi_below / rsi_above / breakout / bearish_volume
  #   loss_pct / profit_pct

# ── 全市场摘选（独立于上面的自选股选股） ──
# 流程: 全A代码池 → 批量 quote 廉价预筛 → 对候选并发跑 screener 条件 → 打分排序 → 落库
# 运行: python scripts/scheduled_screen.py --no-push
# 环境变量覆盖示例: STOCK_AI_MARKET_SCAN__MIN_AMOUNT_WAN=5000
market_scan:
  pool: "all_a"              # all_a / watchlist / portfolio / file:./codes.txt / 逗号分隔
  batch_size: 50             # 预筛时每批 quote 的数量
  candidate_limit: 600       # 预筛后最多保留多少只（按成交额降序），0 = 不限
  min_amount_wan: 3000       # 成交额下限（万元），过滤僵尸股
  min_price: 2.0
  max_price: 500.0
  max_change_pct: 9.8        # 排除涨跌停附近，0 = 不限
  exclude_st: true
  exclude_delisted: true
  exclude_star: false        # 跳过科创板 688/689；Web 勾选框与 --exclude-star 可临时覆盖
  top_n: 20                  # 报告/日报里展示的命中数
  side: "buy"                # buy / sell
  max_workers: 6             # 候选 K 线并发数
  kline_count: 90
  all_a_cache_days: 7
  pool_size_limit: 0

  # 摘选规则独立于上面的 screener（不影响 stock-ai sn）。
  # 全市场候选多，用「至少命中 2 条」宽进严出；原 screener.buy 的 mode=all
  # 加 sector_strong/量比1.5 在大盘里几乎必然 0 命中。
  # 不填 mode/rules 时使用内置默认（就是下面这组）；
  # 想完全沿用 screener.buy 的规则，改成 inherit_screener: true。
  inherit_screener: false
  mode: "atleast:2"
  rules:
    - name: ma_uptrend            # MA20 向上
      params: { ma: 20, lookback: 5 }
    - name: price_above_ma        # 股价站上 MA20
      params: { ma: 20 }
    - name: ma_bull               # MA5 > MA10 > MA20 多头排列
      params: {}
    - name: macd_golden           # 最近 3 根内 MACD 金叉
      params: { lookback: 3 }
    - name: volume_expand         # 量比放宽到 1.2（原 1.5）
      params: { ma_window: 5, ratio: 1.2 }

# ── 今日目标最高价（统计分位数口径，不训练模型） ──
# 用法: stock-ai target-high sh600519 / Web「AI 预测」页自动展示
# 环境变量覆盖示例: STOCK_AI_FORECAST__HIGH__LOOKBACK=90
forecast:
  high:
    lookback: 120              # 历史样本回看交易日数
    levels: [50, 75, 90]       # 分位数口径：下沿 / 中枢 / 上沿
    backtest_days: 60          # walk-forward 回测天数（只用预测时点之前的数据）
    decay_alpha: 0.7           # 盘中剩余空间衰减指数：越小，区间随时间收敛越快
